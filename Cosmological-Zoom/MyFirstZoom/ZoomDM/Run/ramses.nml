&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nremap=20
nsubcycle=1,1,1,1,2
ncontrol=1
verbose=.false.
clumpfind=.true.
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='../ICs/ics_zoom_dm/level_007'
initfile(2)='../ICs/ics_zoom_dm/level_008'
initfile(3)='../ICs/ics_zoom_dm/level_009'
/

&OUTPUT_PARAMS
delta_aout=0.025
aend=1.0
/

&AMR_PARAMS
levelmin=7
levelmax=18
nexpand=4,1,1
ngridtot=3000000
nparttot=10000000
/

&POISSON_PARAMS
epsilon=1.d-3
/

&REFINE_PARAMS
m_refine=12*8.,
ivar_refine=0
mass_cut_refine=1.49012e-08
interpol_var=1
interpol_type=0
/

&CLUMPFIND_PARAMS
relevance_threshold=3
density_threshold=80.
saddle_threshold=200.
mass_threshold=100.
ivar_clump=0
clinfo=.false.
/
